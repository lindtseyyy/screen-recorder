<Window x:Class="ScreenRecorder.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ScreenRecorder.UI"
        Title="Screen Recorder"
        Width="560" MinWidth="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <ui:InverseBooleanConverter x:Key="Inverse" />

        <!-- Bordered card around each settings section. -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Source tiles: bordered cards, accent border when selected. -->
        <Style x:Key="TileItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="10" Padding="12,10,12,10"
                                Background="Transparent"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Bd" Property="Padding" Value="11,9,11,9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Audio chips: pills, accent border when on. -->
        <Style x:Key="Chip" TargetType="ToggleButton">
            <Setter Property="Padding" Value="14,6,14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="16" Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quiet option button (No audio, banner buttons). -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Padding" Value="8,6,8,6" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="16" Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent record button. -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,14,12,14" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outline companion to the Record button: same corners and padding, hollow fill. -->
        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="10,14,10,14" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark dropdowns (settings popup, mic picker): fixed dark surfaces so the
             white text stays readable regardless of theme. -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border CornerRadius="6" Background="#3A3A3A"
                                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                    BorderThickness="1" Padding="8,6,28,6"
                                    MouseLeftButtonDown="OnComboBoxToggle">
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="▾" Foreground="White" FontSize="10"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="0,0,10,0" IsHitTestVisible="False" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#2D2D2D" CornerRadius="6"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                        BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="160">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="8,6,8,6" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Settings (locked while recording; replaced by the saving screen while saving) -->
        <StackPanel Grid.Row="0" IsEnabled="{Binding IsBusy, Converter={StaticResource Inverse}}">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSaving}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="What to record" FontSize="14" FontWeight="SemiBold" />
                    <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource TileItem}"
                             BorderThickness="0" Background="Transparent" Margin="0,8,-8,-8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel MinWidth="104">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.7" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Audio" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ToggleButton Content="🔊 System sound" IsChecked="{Binding SystemAudioOn}"
                                      Style="{StaticResource Chip}" />
                        <ToggleButton Content="🎤 Microphone" IsChecked="{Binding MicOn}"
                                      IsEnabled="{Binding MicChipEnabled}" ToolTip="{Binding MicChipTooltip}"
                                      Style="{StaticResource Chip}" />
                        <Button Content="🔇 No audio" Command="{Binding NoAudioCommand}"
                                ToolTip="Turn off system sound and microphone"
                                Foreground="White" Padding="14,6,14,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding SystemAudioOn}" Value="False" />
                                                <Condition Binding="{Binding MicOn}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding Microphones}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedMicrophone, Mode=TwoWay}"
                              Style="{StaticResource DarkComboBox}"
                              ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                              Visibility="{Binding MicPickerVisible, Converter={StaticResource BoolToVis}}"
                              Margin="0,8,0,0" />
                    <TextBlock Text="{Binding MicDisplayName}" Opacity="0.7" Foreground="White"
                               Visibility="{Binding MicNameVisible, Converter={StaticResource BoolToVis}}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Save to" FontSize="14" FontWeight="SemiBold" />
                    <DockPanel Margin="0,8,0,0">
                        <Button Content="Change" Command="{Binding ChangeFolderCommand}"
                                DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,4,12,4" />
                        <TextBlock Text="{Binding SaveFolder}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Opacity="0.8" />
                    </DockPanel>
                    <TextBlock Text="{Binding StorageEstimate}" FontSize="12" Opacity="0.7"
                               Margin="0,6,0,0"
                               Visibility="{Binding HasStorageEstimate, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <DockPanel Margin="0,8,0,0">
                <Button x:Name="SettingsButton" Content="⚙ Settings" DockPanel.Dock="Right"
                        Click="OnSettingsClick" Style="{StaticResource OutlineButton}"
                        VerticalAlignment="Stretch"
                        ToolTip="Frame rate, quality and mouse cursor options" />
                <Button Command="{Binding RecordCommand}"
                        IsEnabled="{Binding RecordEnabled}"
                        Style="{StaticResource AccentButton}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,8,0">
                    <TextBlock><Run Text="● " Foreground="#FF6B6B" /><Run Text="Record" /></TextBlock>
                </Button>
            </DockPanel>
            <Popup x:Name="SettingsPopup" StaysOpen="False" Placement="Bottom"
                   PlacementTarget="{Binding ElementName=SettingsButton}">
                <Border Background="#2D2D2D"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel MinWidth="200">
                        <TextBlock Text="Frame rate" FontWeight="SemiBold" Foreground="White" />
                        <ComboBox ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding Fps, Mode=TwoWay}"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                  Margin="0,6,0,0" />
                        <TextBlock Text="Quality" FontWeight="SemiBold" Foreground="White" Margin="0,12,0,0" />
                        <ComboBox ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding Quality, Mode=TwoWay}"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                  Margin="0,6,0,0" />
                        <CheckBox Content="Show mouse cursor" IsChecked="{Binding ShowCursor}"
                                  Foreground="White" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Popup>
        </StackPanel>

        <!-- Recording state -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                    Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}"
                    Margin="0,16,0,0">
            <Button Content="⏸ Pause / resume" Command="{Binding PauseResumeCommand}"
                    Padding="12,6,12,6" Margin="0,0,8,0" />
            <Button Content="⏹ Stop" Command="{Binding StopCommand}" Padding="12,6,12,6" />
        </StackPanel>

        <!-- Saving screen: from Stop until the file is complete on disk (PLAN §6.6) -->
        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Padding="18,16,18,16"
                Visibility="{Binding IsSaving, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SavePercentText}"
                               FontSize="16" FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular" />
                    <TextBlock Text="Saving recording…" FontSize="16" FontWeight="SemiBold" />
                </DockPanel>
                <TextBlock Text="{Binding SaveStageText}" Opacity="0.8" Margin="0,4,0,0" />
                <ProgressBar Value="{Binding SaveProgressValue, Mode=OneWay}" Maximum="100"
                             Height="6" Margin="0,12,0,0" />
                <TextBlock Text="{Binding SaveDetailsText}" FontSize="12" Opacity="0.7"
                           Margin="0,10,0,0" TextTrimming="CharacterEllipsis"
                           Typography.NumeralAlignment="Tabular" />
            </StackPanel>
        </Border>

        <!-- Status banner -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="12,8,12,8" CornerRadius="6"
                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                BorderThickness="1"
                Visibility="{Binding StatusVisible, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="BorderBrush" Value="#C42B1C" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="#C42B1C" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                            Visibility="{Binding HasSavedPath, Converter={StaticResource BoolToVis}}">
                    <Button Content="Open" Command="{Binding OpenFileCommand}"
                            Style="{StaticResource GhostButton}"
                            Padding="12,2,12,2" Margin="0,0,8,0" />
                    <Button Content="Show in folder" Command="{Binding ShowInFolderCommand}"
                            Style="{StaticResource GhostButton}"
                            Padding="12,2,12,2" />
                </StackPanel>
                <Button Content="Open microphone settings" Command="{Binding OpenMicSettingsCommand}"
                        Visibility="{Binding ShowPrivacyButton, Converter={StaticResource BoolToVis}}"
                        Padding="12,2,12,2" Margin="0,8,0,0" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
