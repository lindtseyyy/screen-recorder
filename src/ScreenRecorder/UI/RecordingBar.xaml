<Window x:Class="ScreenRecorder.UI.RecordingBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="52" SizeToContent="Width" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize" ShowActivated="False">
    <Window.Resources>
        <!--
            Flat, matte buttons: no gradient, border or glow. Each button sets its
            own Background (the state colors live in RecordingBar.xaml.cs); hover
            lightens and press darkens it with a translucent layer, so every color
            gets matching feedback without bright highlight colors.
        -->
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,5,12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <Grid>
                                <Border x:Name="Shade" CornerRadius="6" Background="Transparent" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shade" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shade" Property="Background" Value="#29000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="26" Background="#CC1E1E1E" Padding="14,6,14,6"
            MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove"
            MouseLeftButtonUp="OnMouseUp" LostMouseCapture="OnCaptureLost">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="Dot" Width="10" Height="10" Margin="0,0,8,0"
                     VerticalAlignment="Center" />
            <TextBlock x:Name="PausedLabel" Text="Paused" FontSize="14" Margin="0,0,8,0"
                       VerticalAlignment="Center" Visibility="Collapsed" />
            <TextBlock x:Name="TimeText" Text="0:00:00" Foreground="White" FontSize="14"
                       Typography.NumeralAlignment="Tabular" MinWidth="60"
                       Margin="0,0,8,0" VerticalAlignment="Center" />
            <!-- Status, not a button: dimmer and smaller than the buttons. -->
            <TextBlock x:Name="SystemSoundText" Text="System sound on" Foreground="#B3FFFFFF"
                       FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" />
            <Button x:Name="MicButton" Style="{StaticResource BarButton}" Click="OnMicClick"
                    VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="96" />
            <Button x:Name="PauseButton" Style="{StaticResource BarButton}" Click="OnPauseClick"
                    VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="70" />
            <Button x:Name="StopButton" Content="Stop" Style="{StaticResource BarButton}"
                    Click="OnStopClick" VerticalAlignment="Center" MinWidth="64" />
        </StackPanel>
    </Border>
</Window>
